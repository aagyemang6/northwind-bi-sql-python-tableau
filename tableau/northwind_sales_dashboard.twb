      <column caption='Sales Per Month' datatype='real' name='[Calculation_2034681224429568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer Name], [ProductName], DATETRUNC(&apos;month&apos;, [OrderDate]) : SUM([Net Sales])}' />
      </column>
      <column caption='Max Monthly Sales' datatype='real' name='[Calculation_2034681225080833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer Name], [ProductName] : MAX([Calculation_2034681224429568])}' />
      </column>
      <column caption='MonthOfHighestSales' datatype='datetime' name='[Calculation_2034681225302018]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_2034681224429568] = [Calculation_2034681225080833] THEN DATETRUNC(&apos;month&apos;, [OrderDate]) END' />
      </column>
