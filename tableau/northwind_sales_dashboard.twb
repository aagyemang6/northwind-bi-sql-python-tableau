    <datasource caption='Custom SQL Query (Northwind)' inline='true' name='federated.0p0uidj0olq9wg1cwpulx0zedke0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='localhost' name='sqlserver.038zex21dbguvj11jndj80pkqd1a'>
            <connection application-intent='false' authentication='sspi' class='sqlserver' dbname='Northwind' multi-subnet-failover='false' odbc-native-protocol='yes' one-time-sql='' server='localhost' />
          </named-connection>
        </named-connections>
        <relation connection='sqlserver.038zex21dbguvj11jndj80pkqd1a' name='Custom SQL Query' type='text'>SELECT &#13;
    o.OrderID,&#13;
    o.OrderDate,&#13;
    c.CompanyName AS [Customer Name],&#13;
    c.City AS [Customer City],&#13;
    c.Country AS [Customer Country],&#13;
    cat.CategoryName,&#13;
    p.ProductName,&#13;
    CAST(od.UnitPrice * od.Quantity * (1 - od.Discount) AS decimal(10,2)) AS [Net Sales]&#13;
FROM &#13;
    dbo.Orders o&#13;
    INNER JOIN dbo.[Order Details] od ON o.OrderID = od.OrderID&#13;
    LEFT JOIN dbo.Customers c ON o.CustomerID = c.CustomerID&#13;
    LEFT JOIN dbo.Products p ON od.ProductID = p.ProductID&#13;
    LEFT JOIN dbo.Categories cat ON p.CategoryID = cat.CategoryID</relation>
